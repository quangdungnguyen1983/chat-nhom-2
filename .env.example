# Mẫu biến môi trường – 09-detailed-design.md mục 11.
# Sao chép thành server/.env rồi điền giá trị. KHÔNG commit file .env.
NODE_ENV=development
PORT=3000
# Địa chỉ giao diện mà trình duyệt thấy (kiểm tra Origin). Local dev: Vite ở 5173.
APP_ORIGIN=http://localhost:5173
# SQLite (ADR-01). Đường dẫn tương đối tính từ thư mục server/prisma.
DATABASE_URL=file:../data/chat.db
SESSION_TTL_HOURS=8
# true khi chạy sau HTTPS (Codespaces demo); false khi local HTTP.
COOKIE_SECURE=false
COOKIE_NAME=sid
LOG_LEVEL=info
